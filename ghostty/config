# Font configuration
font-family = JetBrainsMono Nerd Font
font-size = 16

# Window settings
window-padding-balance = true
window-decoration = true

# Theme: Vitesse (ported from antfu/vscode-theme-vitesse, matches nvim colorscheme)
# switches with macOS appearance; theme files live in ghostty/themes/
theme = dark:Vitesse Dark,light:Vitesse Light Soft

shell-integration = fish

macos-icon = xray

keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+j=goto_split:bottom
