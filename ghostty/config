# Font configuration
font-family = JetBrainsMono Nerd Font
font-size = 16

# Window settings
window-padding-balance = true
# window-decoration = false
# macos-titlebar-style = hidden

# Theme: GitHub Light (matches nvim colorscheme github_light)
# switches with macOS appearance; theme files live in ghostty/themes/
# theme = dark:Vitesse Dark,light:GitHub Light
theme = Catppuccin Macchiato

shell-integration = fish

macos-icon = xray

keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+j=goto_split:bottom

# custom-shader = ~/ghostty-shaders/cursor_blaze.glsl
custom-shader = ~/.config/ghostty/shaders/in-game-crt-cursor.glsl
